{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://local/jspuzzle/puzzle.schema.json",
 "title": "Puzzle input",
 "type": "object",
 "required": [
  "id",
  "size",
  "grid",
  "hints"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "size": {
   "type": "integer",
   "minimum": 2
  },
  "kind": {
   "enum": [
    "official",
    "example",
    "generated"
   ]
  },
  "title": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "ingest": {
   "type": "object"
  },
  "grid": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    }
   }
  },
  "hints": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "row",
     "col",
     "value"
    ],
    "properties": {
     "row": {
      "type": "integer",
      "minimum": 1
     },
     "col": {
      "type": "integer",
      "minimum": 1
     },
     "value": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "hint_count": {
   "type": "integer"
  },
  "row_hint_counts": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  }
 }
}